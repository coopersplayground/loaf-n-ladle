# Copy this file to .env (in this same app/ directory) and fill in your values.
# .env is gitignored — never commit real credentials.

# Admin account created on first run
LNL_ADMIN_EMAIL=admin@example.com
LNL_ADMIN_PASSWORD=change-me

# Stripe keys (optional — can also be entered later in Admin → Stripe API)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
